
# ---------------------------------------------------------------------------
# Blog Admin CMS (required to use /admin)
# ---------------------------------------------------------------------------

# Single shared admin password. Minimum 8 characters.
ADMIN_PASSWORD=123456@Mb

# Secret used to sign the admin session JWT. Minimum 16 characters — use a long
# random string (e.g. `openssl rand -base64 32`).
ADMIN_SESSION_SECRET=A06TB0vqYuUI/ThNuqFclwzUq4/wbkQaDJ9lpsyrTRs=
# ---------------------------------------------------------------------------
# Optional: Vercel Blob (remote blog JSON + image uploads on serverless).
# Leave blank for local/self-hosted: posts persist to data/blog/posts.json and
# uploads to public/images/blog-uploads/.
# NOTE: with Blob enabled, the public /blog read layer (src/lib/blog.ts) needs
# to be made async to see runtime-created posts — see the note in that file.
# ---------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=
